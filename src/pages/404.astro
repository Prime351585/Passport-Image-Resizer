---
// Real 404 page. Without it Cloudflare Pages serves the homepage with a 200
// status for every unknown URL ("soft 404"), which Google treats as duplicates.
import Layout from '../layouts/Layout.astro';

const links = [
  { name: 'Resize Image', href: '/resize' },
  { name: 'Compress Image', href: '/compress' },
  { name: 'Crop Image', href: '/crop' },
  { name: 'Passport Photo', href: '/passport' },
  { name: 'Compress PDF', href: '/compress-pdf' },
  { name: 'Blog', href: '/blogs' },
];
---

<Layout
  title="Page not found | Resize-It"
  description="This page doesn't exist. Try one of Resize-It's free image tools instead."
  noindex
>
  <section class="mt-[80px] md:mt-0 px-4 py-20 text-center">
    <p class="text-sm font-medium text-primary">404</p>
    <h1 class="mt-2 font-crimson text-[36px] md:text-[52px] text-gray-900">Page not found</h1>
    <p class="mt-3 text-gray-600">The page you're looking for doesn't exist or has moved.</p>
    <ul class="mt-8 flex flex-wrap justify-center gap-2 max-w-2xl mx-auto">
      {links.map((l) => (
        <li>
          <a href={l.href} class="inline-block px-4 py-2 rounded-full border border-gray-200 text-gray-700 hover:border-primary hover:text-primary transition-colors">{l.name}</a>
        </li>
      ))}
    </ul>
    <a href="/" class="inline-block mt-8 text-primary font-medium hover:underline">Go to the homepage →</a>
  </section>
</Layout>
