---
import ToolPageLayout from '../../../layouts/ToolPageLayout.astro';
import CropToolContainer from '../../../components/CropToolContainer';
import { getPresetHreflangAlternates, getPresetUrl, isPresetTranslated, getPresetSlug, CROP_PRESETS, SUPPORTED_LANGUAGES, getToolSlug, PRESET_DIMENSIONS, presetAspectRatio } from '../../../utils/i18n';

export async function getStaticPaths() {
  const paths = [];
  const nonEnglishLangs = SUPPORTED_LANGUAGES.filter(l => l !== 'en');
  const allPresetFiles = import.meta.glob('../../../i18n/presets/crop-*.json', { eager: true });

  for (const lang of nonEnglishLangs) {
    for (const presetId of CROP_PRESETS) {
      const presetSlug = getPresetSlug(presetId, lang);
      const filePath = `../../../i18n/presets/crop-${presetId}-${lang}.json`;
      const presetDataModule = allPresetFiles[filePath] as any;
      
      // Fallback to English if missing
      const data = isPresetTranslated('crop', presetId, lang) && presetDataModule ? presetDataModule.default : (allPresetFiles[`../../../i18n/presets/crop-${presetId}-en.json`] as any)?.default;

      if (data) {
        paths.push({
          params: { lang, preset: presetSlug },
          props: { presetId, lang, presetData: data }
        });
      }
    }
  }

  return paths;
}

const { presetId, lang, presetData } = Astro.props;
// Untranslated: an English page that defers to the English URL.
const translated = isPresetTranslated('crop', presetId, lang);
const pageLang = translated ? lang : 'en';
const canonicalUrl = getPresetUrl('crop', presetId, pageLang);
const hreflangAlternates = translated ? getPresetHreflangAlternates('crop', presetId) : [];
const breadcrumbs = [
  { name: 'Home', url: `/` },
  { name: 'Crop', url: `/${lang}/${getToolSlug('crop', lang)}` },
  { name: presetData.h1, url: canonicalUrl },
];
---

<ToolPageLayout
  lang={pageLang}
  toolData={presetData}
  canonicalUrl={canonicalUrl}
  hreflangAlternates={hreflangAlternates}
  breadcrumbs={breadcrumbs}
>
  <CropToolContainer client:load slot="tool" initialAspectRatio={presetAspectRatio(presetId)} outputSize={PRESET_DIMENSIONS[presetId]} />
</ToolPageLayout>
