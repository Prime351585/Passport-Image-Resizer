---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import CompressToolContainer from '../components/CompressToolContainer';
import { getToolHreflangAlternates, getToolUrl } from '../utils/i18n';

// Load English compress i18n data
import toolData from '../i18n/tools/compress-en.json';

const canonicalUrl = getToolUrl('compress', 'en');
const hreflangAlternates = getToolHreflangAlternates('compress');
const breadcrumbs = [
  { name: 'Home', url: 'https://www.resize-it.com' },
  { name: toolData.h1, url: canonicalUrl },
];
---

<ToolPageLayout
  lang="en"
  toolData={toolData}
  canonicalUrl={canonicalUrl}
  hreflangAlternates={hreflangAlternates}
  breadcrumbs={breadcrumbs}
>
  <div slot="tool">
    <CompressToolContainer client:load />
    <nav aria-label="Compress to a set size" class="max-w-3xl mx-auto mt-6 px-4 text-center text-sm text-gray-600">
      Need a specific limit for a form?
      <a href="/compress/20kb" class="text-primary underline">Compress to 20 KB</a> ·
      <a href="/compress/50kb" class="text-primary underline">50 KB</a> ·
      <a href="/compress/100kb" class="text-primary underline">100 KB</a>
    </nav>
  </div>
</ToolPageLayout>