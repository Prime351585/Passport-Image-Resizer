---
import Layout from '../layouts/Layout.astro';
import ImageToolContainer from '../components/ImageToolContainer';
import { generateFaqSchema } from '../utils/schemas';

// ─── Tool catalogue (homepage grid) ──────────────────────────────────────────
// `icon` is the inner markup of a 24x24 stroke icon.
const ICONS = {
  resize: '<path d="M15 3h6v6"/><path d="M9 21H3v-6"/><path d="M21 3l-7 7"/><path d="M3 21l7-7"/>',
  crop: '<path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/>',
  compress: '<path d="M4 14h6v6"/><path d="M20 10h-6V4"/><path d="M14 10l7-7"/><path d="M3 21l7-7"/>',
  corners: '<rect x="3" y="3" width="18" height="18" rx="6"/>',
  invert: '<circle cx="12" cy="12" r="9"/><path d="M12 3v18a9 9 0 0 0 0-18z" fill="currentColor"/>',
  lighten: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  saturate: '<path d="M12 2.7l5.7 5.7a8 8 0 1 1-11.4 0z"/>',
  convert: '<path d="M17 2l4 4-4 4"/><path d="M3 11V9a3 3 0 0 1 3-3h15"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a3 3 0 0 1-3 3H3"/>',
  pdf: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 15h6"/>',
  merge: '<path d="M8 6h10a2 2 0 0 1 2 2v12"/><rect x="4" y="2" width="12" height="16" rx="2"/>',
  passport: '<rect x="5" y="2" width="14" height="20" rx="2"/><circle cx="12" cy="10" r="3"/><path d="M8.5 17a4 4 0 0 1 7 0"/>',
};

const toolGroups = [
  {
    name: 'Edit',
    tools: [
      { name: 'Resize Image', href: '/resize', desc: 'Exact pixels, %, cm, mm or inches.', icon: ICONS.resize },
      { name: 'Crop Image', href: '/crop', desc: 'Free crop or social media ratios.', icon: ICONS.crop },
      { name: 'Compress Image', href: '/compress', desc: 'Hit a target size in KB.', icon: ICONS.compress },
      { name: 'Round Corners', href: '/round-corners', desc: 'Rounded or circular edges.', icon: ICONS.corners },
    ],
  },
  {
    name: 'Adjust',
    tools: [
      { name: 'Invert Image', href: '/invert', desc: 'Negative / reversed colours.', icon: ICONS.invert },
      { name: 'Lighten Image', href: '/lighten', desc: 'Brighten dark photos.', icon: ICONS.lighten },
      { name: 'Saturate Image', href: '/saturate', desc: 'Boost or mute colour.', icon: ICONS.saturate },
      { name: 'Passport Photo', href: '/passport', desc: 'Official sizes for 60+ countries.', icon: ICONS.passport },
    ],
  },
  {
    name: 'Convert',
    tools: [
      { name: 'JPEG to WebP', href: '/jpeg-to-webp', desc: 'Smaller files for the web.', icon: ICONS.convert },
      { name: 'PNG to WebP', href: '/png-to-webp', desc: 'Keep transparency, cut size.', icon: ICONS.convert },
      { name: 'JPEG to PNG', href: '/jpeg-to-png', desc: 'Lossless PNG output.', icon: ICONS.convert },
      { name: 'WebP to JPEG', href: '/webp-to-jpeg', desc: 'Open WebP anywhere.', icon: ICONS.convert },
      { name: 'WebP to PNG', href: '/webp-to-png', desc: 'WebP to lossless PNG.', icon: ICONS.convert },
    ],
  },
  {
    name: 'PDF',
    tools: [
      { name: 'Compress PDF', href: '/compress-pdf', desc: 'Shrink PDFs for email & forms.', icon: ICONS.pdf },
      { name: 'Merge PDF', href: '/merge-pdf', desc: 'Combine files into one PDF.', icon: ICONS.merge },
    ],
  },
];

const presets = [
  { label: '3000×3000', href: '/resize/3000x3000' },
  { label: 'Instagram post', href: '/resize/instagram-post' },
  { label: 'YouTube thumbnail', href: '/resize/youtube-thumbnail' },
  { label: 'Facebook cover', href: '/resize/facebook-cover' },
  { label: 'Passport photo', href: '/passport' },
];

const allTools = toolGroups.flatMap((g) => g.tools);

// ─── Passport countries (derived from the data files) ────────────────────────
const passportFiles = import.meta.glob('../i18n/passport/*.json');
const countries = Object.keys(passportFiles)
  .map((p) => p.split('/').pop()!.replace('.json', ''))
  .map((slug) => ({
    slug,
    name: slug === 'schengen-area'
      ? 'Schengen Area'
      : slug.split('-').map((w) => w[0].toUpperCase() + w.slice(1)).join(' '),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));
const countryCount = countries.length;
const popularCountries = ['united-states', 'india', 'united-kingdom', 'canada', 'pakistan', 'nigeria', 'schengen-area', 'china']
  .map((slug) => countries.find((c) => c.slug === slug))
  .filter((c): c is { slug: string; name: string } => Boolean(c));

// ─── FAQ ─────────────────────────────────────────────────────────────────────
const faqs = [
  {
    question: 'Is Resize-It really free?',
    answer: 'Yes. Every tool is free with no sign-up, no watermark and no daily limit.',
  },
  {
    question: 'Are my images uploaded to a server?',
    answer: 'No. Images are processed entirely inside your browser, so your files never leave your device.',
  },
  {
    question: 'Can I resize several images at once?',
    answer: 'Yes. Select or drop multiple images, choose your size once, and download them all together as a ZIP file.',
  },
  {
    question: 'Which image formats are supported?',
    answer: 'You can resize and compress JPG, PNG and WebP images, convert between JPEG, PNG and WebP, and compress or merge PDF files.',
  },
  {
    question: 'How do I make a passport photo of the right size?',
    answer: 'Open the passport tool, pick your country, and upload a photo. Resize-It crops it to the official dimensions and can lay out several copies on a printable sheet.',
  },
];

const pageSchemas = [generateFaqSchema(faqs)];
---

<Layout
  title="Resize-It: Free Online Image Resizer, Compressor & Converter"
  description="Resize, compress, crop and convert images free in your browser. Exact pixel, KB and passport photo sizes. No uploads, no sign-up, no watermark."
  structuredData={pageSchemas}
>
  <!-- ═══ Hero: the tool itself ═══ -->
  <section class="mt-[80px] md:mt-0 px-4 pt-8 md:pt-12 pb-10">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="font-crimson text-[36px] leading-[1.15] md:text-[52px] text-gray-900">Resize images online for free</h1>
      <p class="mt-4 text-gray-600 text-lg max-w-2xl mx-auto">
        Pixels, percent, cm or inches. No uploads, no sign-up. Your photos never leave your device.
      </p>
    </div>

    <div class="mt-8">
      <ImageToolContainer client:load />
    </div>

    <div class="mt-6 max-w-4xl mx-auto flex flex-wrap items-center justify-center gap-2 text-sm">
      <span class="text-gray-500 mr-1">Popular sizes:</span>
      {presets.map((p) => (
        <a href={p.href} class="px-3 py-1.5 rounded-full border border-gray-200 bg-white text-gray-700 hover:border-primary hover:text-primary transition-colors">
          {p.label}
        </a>
      ))}
    </div>
  </section>

  <!-- ═══ All tools ═══ -->
  <section class="px-4 py-14" aria-labelledby="tools-heading">
    <div class="max-w-5xl mx-auto">
      <h2 id="tools-heading" class="font-crimson text-[28px] md:text-[36px] text-gray-900">All tools</h2>
      <ul class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-2">
        {allTools.map((tool) => (
          <li>
            <a href={tool.href} class="flex items-center gap-3 p-3 rounded-xl border border-gray-200 hover:border-primary hover:text-primary transition-colors">
              <span class="shrink-0 w-8 h-8 rounded-lg bg-tertiary/60 text-primary flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={tool.icon} />
              </span>
              <span class="text-sm font-medium">{tool.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ Passport ═══ -->
  <section class="px-4 py-14 bg-gray-50" aria-labelledby="passport-heading">
    <div class="max-w-5xl mx-auto">
      <h2 id="passport-heading" class="font-crimson text-[28px] md:text-[36px] text-gray-900">Passport photos</h2>
      <p class="mt-2 text-gray-600">Official sizes for {countryCount} countries, with a printable sheet.</p>
      <div class="mt-5 flex flex-wrap gap-2">
        {popularCountries.map((c) => (
          <a href={`/passport/${c.slug}`} class="px-3 py-1.5 rounded-full bg-white border border-gray-200 text-sm text-gray-700 hover:border-primary hover:text-primary transition-colors">{c.name}</a>
        ))}
        <a href="/passport" class="px-3 py-1.5 rounded-full text-sm font-medium text-primary hover:underline">All countries →</a>
      </div>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="px-4 py-14" aria-labelledby="faq-heading">
    <div class="max-w-3xl mx-auto">
      <h2 id="faq-heading" class="font-crimson text-[28px] md:text-[36px] text-gray-900">Questions</h2>
      <div class="mt-4 divide-y divide-gray-200 border-y border-gray-200">
        {faqs.map((f) => (
          <details class="group py-4">
            <summary class="flex justify-between items-center cursor-pointer list-none font-medium text-gray-900">
              {f.question}
              <span class="ml-4 text-primary transition-transform group-open:rotate-45 text-xl leading-none" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 text-gray-600">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
