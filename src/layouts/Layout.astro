---
import Header from "../components/Header.astro";
import "../styles/global.css"
import Footer from "../components/Footer.astro";
import type { HreflangAlternate } from "../utils/i18n";
import { RTL_LANGUAGES } from "../utils/i18n";
import type { SupportedLanguage } from "../utils/i18n";
import { generateOrganizationSchema, generateWebsiteSchema } from "../utils/schemas";

export interface Props {
  title?: string;
  description?: string;
  lang?: SupportedLanguage;
  canonicalUrl?: string;
  hreflangAlternates?: HreflangAlternate[];
  structuredData?: object | object[];
  /** Keep this page out of search results (e.g. the 404 page). */
  noindex?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  canonicalUrl,
  hreflangAlternates = [],
  structuredData,
  noindex = false,
} = Astro.props;

// Get the canonical URL. With build.format 'file', Astro.url.pathname ends in
// ".html" at build time (e.g. /blogs/foo.html), but the site serves clean URLs
// (/blogs/foo), so strip ".html" / "index" and any trailing slash.
let finalCanonicalURL = canonicalUrl;
if (!finalCanonicalURL) {
  let path = Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/\/index$/, '/')
    .replace(/(.)\/$/, '$1');
  if (path === '' || path === '/index') path = '/';
  finalCanonicalURL = new URL(path, 'https://www.resize-it.com').toString();
}

// Determine text direction
const dir = RTL_LANGUAGES.includes(lang as any) ? 'rtl' : 'ltr';

// Site identity schemas on every page; page-specific schemas after.
const schemas = [
  generateOrganizationSchema(),
  generateWebsiteSchema(),
  ...(structuredData
    ? (Array.isArray(structuredData) ? structuredData : [structuredData])
    : []),
];
---

<html lang={lang} dir={dir}>
<head>
  <meta charset="utf-8" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description || "Professional image processing tools"} />
  {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={finalCanonicalURL} />}
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/markdown" href="/llms.txt" />
  <link rel="llms-project" href="/llms.txt" />
  <link rel="ard" type="application/json" href="/.well-known/ard.json" />

  {/* Hreflang tags for international SEO */}
  {hreflangAlternates.map((alt) => (
    <link rel="alternate" hreflang={alt.lang} href={alt.href} />
  ))}

<script async src="https://www.googletagmanager.com/gtag/js?id=G-432HWBTEC5"></script>
		<script is:inline>
		  window.dataLayer = window.dataLayer || [];
		    function gtag(){dataLayer.push(arguments);}
			  gtag('js', new Date());

			    gtag('config', 'G-432HWBTEC5');
				</script>
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
{/* Fonts load without blocking first paint */}
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap">
<link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;0,700;1,400;1,600;1,700&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&display=swap" rel="stylesheet"></noscript>

  {/* Structured Data (JSON-LD) */}
  {schemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>

<body class="bg-white min-h-screen flex flex-col">
  
  <!-- Main Content -->
  <main class="flex-1">
    <Header/>
    <slot />
    <Footer/>
  </main>

  

  <script>
    // Mobile menu toggle
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    mobileMenuButton?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      if (!mobileMenuButton?.contains(target) && !mobileMenu?.contains(target)) {
        mobileMenu?.classList.add('hidden');
      }
    });
  </script>
</body>
</html>